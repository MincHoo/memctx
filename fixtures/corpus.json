  { "content": "图分需要阻尼系数 0.5，否则相邻节点互相抬轿子会把目标顶下去。", "tags": ["architecture", "graph", "pitfall"], "kind": "pitfall", "condition": "启用图分时", "source": "eval.mjs" },

